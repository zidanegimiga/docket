NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
TRUST_PROXY_HOPS=1
DATABASE_URL=postgresql://tickets:tickets@localhost:5432/tickets

# Address of the web app: used for the Origin check and OAuth redirects.
WEB_ORIGIN=http://localhost:3000

# Signing key for access tokens. Generate with: npm run auth:keys -w @docket/api
# Optional in development (a temporary key is used); required in production.
AUTH_PRIVATE_KEY=
AUTH_ISSUER=http://localhost:4000

# Google sign-in. Leave blank to disable.
# Authorised redirect URI: <WEB_ORIGIN>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
